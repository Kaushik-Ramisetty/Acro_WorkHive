# ===============================================================
# HRMS — Unified (Core + Onboarding)
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to version control.
# ===============================================================

# ── App ──────────────────────────────────────────────────────
APP_NAME=HRMS Backend
APP_ENV=development               # development | staging | production
DEBUG=true
HOST=0.0.0.0
PORT=8000
APP_RELOAD=true

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API with credentials.
# Used by both the Core's settings.allowed_origins and the onboarding's
# CORS_ALLOWED_ORIGINS reader.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ── Database ─────────────────────────────────────────────────
# Default: SQLite (zero-config). Set DB_ENGINE=mssql or DATABASE_URL=... to change.
DATABASE_URL=sqlite:///./hrms.db
DB_ENGINE=sqlite
SQLITE_PATH=./hrms.db
DB_ECHO=false

# ── MS SQL Server (uncomment & fill in if DB_ENGINE=mssql) ───
# DATABASE_URL=mssql+pyodbc://USER:PASSWORD@HOST:1433/HRMS?driver=ODBC+Driver+17+for+SQL+Server
# DB_AUTH_MODE=windows
# LOCAL_DB_SERVER=(localdb)\MSSQLLocalDB
# LOCAL_DB_NAME=WorkHiveDB
# LOCAL_DB_DRIVER=ODBC Driver 17 for SQL Server
# LOCAL_DB_USER=
# LOCAL_DB_PASSWORD=

# ── File uploads ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── Security (single secret drives BOTH auth flows) ──────────
# Core's auth_service reads JWT_SECRET; onboarding's utils/jwt_auth reads SECRET_KEY.
# Keep both populated with the SAME value so issued tokens are mutually verifiable.
JWT_SECRET=change-me-to-a-long-random-string
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── 2FA / OTP (used by Core's /auth/login → /auth/verify-otp) ─
OTP_PEPPER=change-me-to-a-long-random-string
OTP_TTL_SECONDS=120

# ── Redis / Celery (used by Core's OTP delivery + audit jobs) ─
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── PII encryption (Onboarding — Aadhaar / PAN / Bank Account) ─
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=replace-with-a-fernet-key

# ── SMTP — Core auth/OTP + Payroll notification emails ───────
# These settings are shared by:
#   • OTP 2FA login emails          (email_service.py)
#   • Payroll workflow notifications (payroll_notifications.py)
#       Trigger 1: Attendance frozen    → Finance users
#       Trigger 2: Payroll submitted    → Finance users
#       Trigger 3: Finance rejected     → HR/Admin users (with reason)
#       Trigger 4: Finance approved     → Finance Head users
#       Trigger 5: Finance Head approved→ HR/Admin/Finance users
#       Trigger 6: Payslips published   → Employees in the run
# When SMTP_USERNAME or SMTP_PASSWORD is empty, emails are logged to
# stdout only (dev-safe fallback). Payroll actions never fail due to
# email errors — failures are logged and the workflow continues.
#
# Gmail setup: enable 2-Step Verification → App Passwords → create
# a 16-character app password and paste it into SMTP_PASSWORD below.
# Do NOT use your Google account password directly.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=WorkHive HRMS
CLIENT_ACTION_BASE_URL=http://localhost:8000

# ── SMTP — Onboarding (offer/IT/welcome/BGV emails) ──────────
# When EMAIL_SIMULATE=true, emails are logged instead of sent.
EMAIL_SIMULATE=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=HRMS HR <hr@yourcompany.com>

# ── Onboarding / BGV recipients ──────────────────────────────
IT_EMAIL=it@yourcompany.com
BGV_VENDOR_EMAIL=vendor@bgvprovider.com
ADMIN_CC_EMAIL=hr@yourcompany.com
COMPANY_NAME=YourCompany

# ── BGV vendor portal ────────────────────────────────────────
BGV_TOKEN_TTL_HOURS=336            # 14 days
FRONTEND_BASE_URL=http://localhost:5173

# ── Onboarding bootstrap passwords (optional) ────────────────
# Initial password assigned during candidate→employee conversion + when a
# candidate-portal user is created. Both have safe legacy fallbacks so
# omitting them keeps existing behaviour. Override in production to rotate
# the boot password centrally.
# DEFAULT_EMPLOYEE_PASSWORD=employee123
# DEFAULT_CANDIDATE_PASSWORD=candidate123
